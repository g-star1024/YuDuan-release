# 御端中枢配置模板（EnvironmentFile 格式，逐行 KEY=VALUE）
# 复制为 /etc/yuduan-hub/env 后按需修改。未设置的项走代码内默认值。

# ============ 必改（生产） ============

# 指令 HMAC 签名密钥（铁律 4）。生成：openssl rand -hex 32
# 副端侧需同步同一密钥（YUDUAN_HMAC_SECRET 环境变量）才能通过验签。
YUDUAN_HMAC_SECRET=

# HMAC 强制模式：1 = 缺密钥的指令一律拒绝（生产必须为 1）
YUDUAN_HMAC_ENFORCE=1

# 密码哈希 pepper（换值会使既有密码全部失效，部署后不得再改）
YUDUAN_PEPPER=

# ============ 监听 ============

# 明文 HTTP/WS 监听（控制台 + API + 设备通道）。空 = 自动探测 8081-8083/18080
YUDUAN_HUB_ADDR=:18241

# TLS/mTLS 监听（生产建议）。设了 YUDUAN_TLS_CERT/KEY 才生效；副端走该端口需配 YUDUAN_CLIENT_CA
# YUDUAN_TLS_ADDR=:8443
# YUDUAN_TLS_CERT=/etc/yuduan-hub/tls/server.crt
# YUDUAN_TLS_KEY=/etc/yuduan-hub/tls/server.key
# YUDUAN_CLIENT_CA=/etc/yuduan-hub/tls/client-ca.crt

# ============ 持久化 ============

# PostgreSQL DSN（不设 = 内存存储，重启即丢；生产必须配置）
# YUDUAN_DB_DSN=postgres://yuduan:CHANGE-ME@127.0.0.1:5432/yuduan?sslmode=disable

# 软件仓库文件目录（M5 分发的包存放处）
YUDUAN_REPO=/var/lib/yuduan-hub/repo

# ============ 安全姿态 ============

# 1 = 新管理员首次登录强制改密（生产必须保持默认开启，勿设 0）
# YUDUAN_ADMIN_MUST_CHANGE_PW=1

# 软件包 Ed25519 签名种子（32 字节 hex，openssl rand -hex 32；不设 = 不签名）
# YUDUAN_SIGN_SEED_FILE=/etc/yuduan-hub/sign-seed

# ============ 远控录像（可选） ============

# 1 = 开启远控会话加密录像
# YUDUAN_RC_RECORD=1
# YUDUAN_RECORD_RETENTION_DAYS=30

# ============ 集群/多中枢（可选） ============

# 本中枢标识与对外公布地址（多中枢指令总线用）
# YUDUAN_HUB_ID=hub-01
# YUDUAN_PUBLIC_ADDR=ws://hub01.yuduan.internal:18241/ws/agent
