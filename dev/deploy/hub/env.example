# 御端中枢配置模板（EnvironmentFile 格式，逐行 KEY=VALUE）
# 复制为 /etc/yuduan-hub/env 后按需修改。未设置的项走代码内默认值。

# ============ 必改（生产） ============

# 指令 HMAC 签名密钥（铁律 4）。生成：openssl rand -hex 32
# 副端侧需同步同一密钥（YUDUAN_HMAC_SECRET 环境变量）才能通过验签。
YUDUAN_HMAC_SECRET=

# HMAC 强制模式：1 = 缺密钥的指令一律拒绝（生产必须为 1）
YUDUAN_HMAC_ENFORCE=1

# 密码哈希 pepper（换值会使既有密码全部失效，部署后不得再改）
YUDUAN_PEPPER=

# ============ 监听 ============

# 明文 HTTP/WS 监听（控制台 + API + 设备通道）。默认 :8080；
# 仅 :8080 被占用时自动回退 8081-8083/18080（显式设置则占用即报错退出）
YUDUAN_HUB_ADDR=:8080

# TLS/mTLS 监听（生产建议）。设了 YUDUAN_TLS_CERT/KEY 才生效；副端走该端口需配 YUDUAN_CLIENT_CA
# YUDUAN_TLS_ADDR=:8443
# YUDUAN_TLS_CERT=/etc/yuduan-hub/tls/server.crt
# YUDUAN_TLS_KEY=/etc/yuduan-hub/tls/server.key
# YUDUAN_CLIENT_CA=/etc/yuduan-hub/tls/client-ca.crt

# UDP 自动发现端口（带外约定：客户端广播目标端口 ↔ 中枢 UDP 监听端口）。默认 18242；
# 广播帧不携带发现端口，帧格式与 Ver=1 均不变。三端（中枢 env、副端、主端 GUI 设置项）
# 必须配成同一个端口：多实例并存时，每个实例及其客户端须配同一个非默认端口，否则会
# 拿到别的实例的 token 导致 claim 失败。存量部署升级不覆盖已有 env——若要用新端口，
# 需手工在 env 中加 YUDUAN_DISCOVERY_PORT=<端口>（三端同步），不动则继续用 18242。
# YUDUAN_DISCOVERY_PORT=18242

# ============ 持久化 ============

# PostgreSQL DSN（不设 = 内存存储，重启即丢；生产必须配置）。
# 支持两种等价格式（内部同一解析）：
#   ① URL 格式（推荐，与 libpq 一致）：
#      YUDUAN_DB_DSN=postgres://yuduan:CHANGE-ME@127.0.0.1:5432/yuduan?sslmode=disable
#   ② libpq 键值格式：
#      YUDUAN_DB_DSN=host=127.0.0.1 port=5432 user=yuduan dbname=yuduan password=CHANGE-ME
# 注：内置 pg 客户端为明文连接，sslmode/其余查询参数被忽略；生产建议内网 + 防火墙白名单。
# 首次部署需先建库建用户（任选其一执行）：
#   sudo -u postgres createuser yuduan -P          # 按提示输入密码
#   sudo -u postgres createdb -O yuduan yuduan
# 或（Docker）：
#   docker exec -it <pg容器> psql -U postgres -c "CREATE USER yuduan PASSWORD 'CHANGE-ME'; CREATE DATABASE yuduan OWNER yuduan;"
# 中枢启动时会自动建表（CREATE TABLE IF NOT EXISTS，幂等），无需手工执行 schema。
# YUDUAN_DB_DSN=postgres://yuduan:CHANGE-ME@127.0.0.1:5432/yuduan?sslmode=disable

# 软件仓库文件目录（M5 分发的包存放处）
YUDUAN_REPO=/var/lib/yuduan-hub/repo

# ============ 安全姿态 ============

# 1 = 新管理员首次登录强制改密（生产必须保持默认开启，勿设 0）
# YUDUAN_ADMIN_MUST_CHANGE_PW=1

# 软件包 Ed25519 签名种子（32 字节 hex，openssl rand -hex 32；不设 = 不签名）
# YUDUAN_SIGN_SEED_FILE=/etc/yuduan-hub/sign-seed

# ============ 远控录像（可选） ============

# 1 = 开启远控会话加密录像
# YUDUAN_RC_RECORD=1
# YUDUAN_RECORD_RETENTION_DAYS=30

# ============ 日志 ============

# 中枢日志落盘文件（D-06：systemd/launchd/计划任务三种托管方式统一从该文件取证，
# 避免「零日志」）。不设 = 仅输出到 stderr（托管方式各自的捕获）。安装脚本自动配置。
# YUDUAN_LOG_FILE=/var/log/yuduan-hub/hub.log

# ============ 集群/多中枢（可选） ============

# 本中枢标识与对外公布地址（多中枢指令总线用）
# YUDUAN_HUB_ID=hub-01
# YUDUAN_PUBLIC_ADDR=ws://hub01.yuduan.internal:8080/ws/agent

# ============ 公网形态（v0.4.26 起，由 -Public / --public 一键部署脚本自动写入） ============
# 以下变量仅用于 P1 公网形态；默认 LAN 部署无需设置。公网形态必须经
# register-task.ps1 -Public（Windows）/ install.sh --public（Linux）/
# install-macos.sh --public（macOS）进入，请勿仅手工把
# YUDUAN_NET_MODE=public 写入本文件（详见 README-deploy.md §G「公网形态约束」）。
# 注意：上方「集群/多中枢」段的 YUDUAN_PUBLIC_ADDR 是多中枢指令总线地址，不是公网口径；
# 公网形态的对外地址由部署脚本按域名写入，请勿在此手工覆盖或混淆。
#
# 网络形态：lan（默认，仅内网、不广播公网地址）| public（显式开启公网形态）。
# public 形态强制显式 TLS 证书（YUDUAN_TLS_CERT/YUDUAN_TLS_KEY），否则中枢拒绝启动。
# YUDUAN_NET_MODE=lan
#
# 公网域名（public 形态）：用于推导 https://<域名>:8443 作为广播/对外地址。
# YUDUAN_PUBLIC_DOMAIN=
#
# 登录防爆破：LAN 形态默认关闭；-Public / public 形态部署脚本自动写 1（开启）。
# YUDUAN_LOGIN_GUARD=1
# 可调项：窗口内最大失败次数 / 统计窗口秒 / 锁定时长秒。
# YUDUAN_LOGIN_MAX_FAILS=5
# YUDUAN_LOGIN_WINDOW_SEC=300
# YUDUAN_LOGIN_LOCK_SEC=300

# ============ v0.4.31 中枢配置 API（可选） ============
# GET/POST /api/v1/config：operator/admin 可读、仅 admin 可写，viewer 无权限。
# 覆盖文件（原子落盘）。env 为初始源，写回值持久化于此，重启后优先于 env 生效。
# 默认 data/hub-config-overrides.json；不设即该默认值。
# YUDUAN_CONFIG_OVERRIDES=data/hub-config-overrides.json
#
# 可经 API 写回的 9 项非敏感配置（括号内为生效方式）：
#   YUDUAN_ALERT_WEBHOOK_URL      告警 webhook（live，即时热更新）
#   YUDUAN_RC_MAX_SEC             远控会话绝对时长上限秒（live）
#   YUDUAN_RC_IDLE_SEC            远控主端空闲上限秒（live）
#   YUDUAN_MAX_DEVICES            设备台账上限，0=默认 5000（live）
#   YUDUAN_BACKUP_KEEP            PG 自动备份保留份数（live）
#   YUDUAN_BACKUP_INTERVAL        PG 自动备份间隔小时，0=关闭（restart，重启后生效）
#   YUDUAN_HMAC_ENFORCE           强制副端指令验签（live，关闭仅限排障）
#   YUDUAN_RC_RECORD              远控加密录像（restart）
#   YUDUAN_RECORD_RETENTION_DAYS  录像留存天数（restart）
# ⚠️ 敏感项一律不开放 API 读写，只能改 env / keystore 后重启：
#   YUDUAN_HMAC_SECRET / YUDUAN_PEPPER / YUDUAN_SIGN_SEED / YUDUAN_CA_KEY /
#   YUDUAN_TLS_KEY / YUDUAN_RECORD_KEY / YUDUAN_DB_DSN / YUDUAN_CLIENT_CA /
#   YUDUAN_CLIENT_CERT / YUDUAN_CLIENT_KEY / YUDUAN_TLS_CAFILE
# GET 响应只回显该「排除清单」名称，绝不回显值；POST 写入会被拒。

# ============ v0.4.31 TLS 证书自动续期（可选，仅 public 形态） ============
# 默认关闭：必须同时 YUDUAN_NET_MODE=public 且 YUDUAN_ACME_AUTORENEW=1 才启动续期看门狗。
# 续期成功后原子替换 cert/key 并经 TLS GetCertificate 热重载，无需重启中枢；
# 失败按指数退避重试，绝不降级为明文。副端 SPKI PIN 不变（密钥对复用时）。
# YUDUAN_ACME_AUTORENEW=1
#
# 域名（逗号分隔）；为空回退 YUDUAN_PUBLIC_DOMAIN。客户端为单域名签发，仅用首个域名。
# YUDUAN_ACME_DOMAINS=hub.example.com
# 注册邮箱；为空回退 admin@<主域名>。
# YUDUAN_ACME_EMAIL=admin@example.com
# HTTP-01 模式：留空=standalone（临时监听 :80）；设目录=webroot 模式（适合已有 80 端口的反向代理）。
# YUDUAN_ACME_WEBROOT=
# YUDUAN_ACME_HTTP_LISTEN=:80
# 显式 ACME Directory URL（留空按 Staging 选 Let's Encrypt）；离线排障请指向本地不可达地址，
# 切勿在未隔离环境实跑生产 Directory。
# YUDUAN_ACME_DIRECTORY=
# YUDUAN_ACME_STAGING=0
# 距到期不足该天数进入续期窗口（默认 20 天）
# YUDUAN_ACME_RENEW_DAYS=20
# 轮询周期（默认 12h，支持 30m 等 Go duration）
# YUDUAN_ACME_CHECK_INTERVAL=12h
# 失败退避上限（默认 1h）
# YUDUAN_ACME_MAX_BACKOFF=1h
# 证书指纹落盘路径（默认 data/cert-fingerprint）
# YUDUAN_ACME_FINGERPRINT_FILE=data/cert-fingerprint

# ============ v0.4.31 登录防爆破增强：全局按源 IP 维度（可选） ============
# 与既有「账号维度」(YUDUAN_LOGIN_MAX_FAILS=5) 并存、独立累计：
# 同 IP 跨多个账号的失败会累加，达阈值封该 IP，防止撞库式遍历账号。
# 默认阈值高于账号维度（20 vs 5），只影响 YUDUAN_LOGIN_GUARD=1 时；锁定仍返 code=4029 + HTTP 200。
# YUDUAN_LOGIN_IP_MAX_FAILS=20
# YUDUAN_LOGIN_IP_WINDOW_SEC=300
# YUDUAN_LOGIN_IP_LOCK_SEC=300
#
# 反代部署：默认 0=只信 RemoteAddr（XFF 可伪造）。仅当反向代理确定会覆盖 XFF 首段时设 1。
# ⚠️ 反代下 RemoteAddr 常全为 127.0.0.1；IP 维度对 loopback 放行，避免跨来源账号锁定 DoS，
#    同时保护回环就绪探针。账号维度保持 v0.4.27 F-04「回环不豁免」不变。
# YUDUAN_TRUST_PROXY=0
# 多中枢共享锁定状态：默认自动（PG 后端可用时落 yuduan_login_guard_ip 表）；设 0 强制仅内存。
# YUDUAN_LOGIN_GUARD_PG=0

# ============ v0.4.31 会话安全（可选，默认关闭） ============
# 服务端会话表 + 主动吊销 + 空闲超时 + 角色变更/改密后旧令牌即时失效。
# 默认关闭（LAN 零回归）；公网自建形态建议显式开启。令牌格式不变，会话键由令牌
# 整体 SHA-256 派生，副端与旧客户端无感。
# YUDUAN_SESSION_ENFORCE=1
# 空闲超时秒数（默认 1800 = 30 分钟；仅低频 REST 管理 API 刷新，绝不挂到 /ws/agent 心跳）
# YUDUAN_SESSION_IDLE_SEC=1800
# 平滑迁移：1 = 开关启用前已签发的旧令牌（无会话记录）放行并自动补建会话，
# 避免开启瞬间把所有已登录客户端踢下线。确认所有客户端重登后可设 0 收紧。
# YUDUAN_SESSION_LEGACY_ALLOW=1
#
# ⚠️ 会话表 yuduan_sessions 已从全库备份导出中排除，且恢复重放时会跳过针对
#    会话表的 INSERT（兼容历史备份）：恢复一次备份不会让已吊销/已过期的旧令牌
#    「复活」。代价：恢复备份后所有客户端需重新登录，属预期行为。
# ⚠️ 就绪探针（POST 127.0.0.1:8080/api/v1/login，只看 HTTP 200/401）不受任何会话开关影响。

# ============ v0.4.31 审计链尾外锚（可选，默认关闭） ============
# 应用哈希链之外的第二道防线：每次「校验审计链」通过后，把链尾 (id, hash) 的
# HMAC 签名以 append-only 方式追加到**库外独立文件**。全库备份（BackupSQL 动态
# 遍历 public 表）与恢复（TRUNCATE ... RESTART IDENTITY CASCADE）都碰不到该文件，
# 故整库回滚可用带外比对发现。默认关闭，关闭时行为与旧版逐字节一致。
# YUDUAN_AUDIT_ANCHOR=0
#   ↑ 0=关闭（默认）；改为 1 才启用。本版全部新增开关默认关闭，LAN 部署零改动、零回归。
#
# 独立签名密钥（推荐，可轮换）。生成：openssl rand -hex 32
# 未配置时回退 YUDUAN_HMAC_SECRET（与令牌签名同密钥，能读 secret 者可自伪造，
# 强度打折，锚文件会标 key_source=hmac-secret-fallback）；两者皆空则不锚定、
# 不写文件、绝不误报链损坏。
# YUDUAN_AUDIT_ANCHOR_KEY=
# 锚文件路径（默认 data/audit-anchor.jsonl）。生产建议放到中枢进程不可写的
# 带外目录或定期同步到另一台机器，见 README-deploy.md「审计外锚」章。
# YUDUAN_AUDIT_ANCHOR_FILE=data/audit-anchor.jsonl
#
# ⚠️ 诚实边界：库外文件只能靠人工/带外比对发现整库回滚，本版**不提供自动告警**；
#    若攻击者同时删除锚文件，仍需异地备份或只读介质。锚文件只追加、绝不改写/删除。
# ⚠️ 严禁把锚点存进 PostgreSQL 表：库内锚表会被备份导出、被 TRUNCATE 清空、
#    被重放伪造，外锚即失去意义。
